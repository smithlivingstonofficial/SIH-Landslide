# Supabase Database & Realtime API Configuration
# Get these credentials from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: SMS Gateway (MSG91 / Twilio) integration for cellular warning alerts
MSG91_AUTH_KEY=
MSG91_SENDER_ID=LNDGRD
MSG91_TEMPLATE_ID=

# Optional: OpenWeatherMap or IMD Private Key (fallback is automatic via Open-Meteo)
NEXT_PUBLIC_OPENWEATHER_KEY=
